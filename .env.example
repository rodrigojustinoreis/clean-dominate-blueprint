# =============================================================
# Environment variables — copy this file to .env and fill values
# NEVER commit the real .env (it is gitignored)
# =============================================================

# --- Frontend (Vite) — exposed in the client bundle ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Google Maps / Places API (frontend)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACE_ID=

# --- Server-side (Netlify functions) — NOT exposed to the client ---
# Used in netlify/functions/google-reviews.mjs
# Set these in: Netlify Dashboard -> Site -> Environment variables
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
