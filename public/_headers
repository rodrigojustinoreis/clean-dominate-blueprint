# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache static assets aggressively (hashed filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
*.jpg
  Cache-Control: public, max-age=2592000
*.png
  Cache-Control: public, max-age=2592000
*.webp
  Cache-Control: public, max-age=2592000
*.svg
  Cache-Control: public, max-age=2592000
*.avif
  Cache-Control: public, max-age=2592000

# Cache fonts
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Cache JS & CSS (hashed)
*.js
  Cache-Control: public, max-age=31536000, immutable
*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — must-revalidate: o navegador/CDN sempre confirma com a origem
# antes de mostrar, então NUNCA aparece página desatualizada depois de um deploy.
# (Era stale-while-revalidate=86400, que servia a versão velha por até 24h e
# fazia o site parecer "antigo" após cada atualização — 02/08/2026.)
# Assets estáticos (/assets/*, *.js, *.css acima) continuam com cache imutável.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Service worker and manifest
/manifest.json
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
